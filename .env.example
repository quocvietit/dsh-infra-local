# Copy to `.env` and edit paths for this machine. Do not commit `.env`.

# Local build: dsh-runtime:1.2.1
# Other machine (prebuilt): vietvqworkspace/dsh-web:1.2.1
DSH_IMAGE=dsh-runtime:1.2.1

# Host folder that contains this compose project (Windows: use forward slashes).
DSH_HOST_ROOT=C:/path/to/dsh-docker
DSH_HOST_PATH_MAP=/workspace=C:/path/to/dsh-docker/workspace;/data=C:/path/to/dsh-docker/data

# 0 = baked image (deploy). 1 = overlay ./deepseek-harness (use docker-compose.dev.yml).
DSH_SOURCE_OVERLAY=0
DSH_COMMIT_HASH=0000000

# 1 = enable Vision Toolkit plugin. 0 = do not link it into the web profile.
DSH_VISION_TOOLKIT=1
