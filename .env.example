# Copy to `.env` and edit paths for this machine. Do not commit `.env`.
# Full steps: BUILD.md

# Local build: dsh-runtime:1.2.1
# Other machine: Hub tag or the tag you docker load
DSH_IMAGE=dsh-runtime:1.2.1

# Host folder of this compose project (forward slashes). Used if PATH_MAP is unset.
DSH_HOST_ROOT=C:/path/to/dsh-docker

# Entire /workspace on another disk/folder (absolute, forward slashes).
# Leave unset to use ./workspace next to compose.
# DSH_WORKSPACE_HOST=E:/code

# Host-open (Explorer). Extra bind mounts MUST appear here (longest prefix).
# Leave unset: /workspace = DSH_WORKSPACE_HOST or ROOT/workspace; /data = ROOT/data.
# DSH_HOST_PATH_MAP=/workspace=E:/code;/workspace/app=D:/other/app;/data=C:/path/to/dsh-docker/data

# 0 = baked image (deploy). 1 = overlay ./deepseek-harness (use docker-compose.dev.yml).
DSH_SOURCE_OVERLAY=0
DSH_COMMIT_HASH=0000000

# LLM API keys (injected into the container). Match Settings → Models `apiKeyEnv`.
# After editing keys: `docker compose up -d` (restart does not reread `.env`).
# Do not commit real keys.
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
