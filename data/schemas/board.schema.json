{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "runPath",
    "projectId",
    "mode",
    "tasks"
  ],
  "properties": {
    "runPath": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "status",
          "phase"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "skill": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "completed",
              "failed"
            ]
          },
          "phase": {
            "type": "string"
          },
          "artifact": {
            "type": "string"
          }
        }
      }
    }
  }
}
